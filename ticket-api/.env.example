# Copy the variables you need into your shell; none of them is required.
# Simulated provider behaviour for POST /tickets/{id}/send: success | timeout | error
TICKET_PROVIDER_MODE=success
# SQLite file location (default: ./db.sqlite3)
TICKETS_DB_PATH=./db.sqlite3
# Development only. Not a real credential.
DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=1
